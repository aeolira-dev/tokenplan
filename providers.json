{
  "_meta": {
    "purpose": "渠道身份层：只放不随模型变化的字段（月费、官网、上游路由策略、限额类型、API 暴露情况）。随模型变化的字段（价格、额度倍数 k、该模型在渠道上的 context/max_output）放在 models/<slug>/channels/ 下。",
    "boundaryRule": "随模型变化的 → 模型文件夹；不随模型变化的 → 本文件。",
    "fxRates": { "USD_CNY": 7.1, "asOf": "2026-10-08", "note": "人民币折算统一用此汇率，页面需标注" },
    "verificationLevels": {
      "official-doc": "渠道官方文档页/API 直接核实",
      "api-endpoint": "渠道公开 API 端点返回值核实",
      "aggregator": "仅聚合平台（OpenRouter/models.dev 等）列出，官网未证",
      "single-source-unverified": "仅第三方单源，未获官方佐证"
    },
    "byModelFields": ["tiers（价格与峰谷窗口）", "quotaMultiple（额度倍数 k）", "quota（该模型折算额度）", "limits.contextTokens", "limits.maxOutputTokens", "notes 中与模型相关者"]
  },

